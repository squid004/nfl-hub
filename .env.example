# Local-dev only. In GitHub Actions these come from repo Secrets/Variables instead.
# Copy to .env and fill in. .env is gitignored.

# --- Supabase (required) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- FantasyPros (paid key; same one as the ff-draft-edge project) ---
FANTASYPROS_API_KEY=
FP_SCORING_YAHOO=PPR      # PPR | HALF | STD
FP_SCORING_ESPN=PPR

# --- Yahoo fantasy ---
# Create an app at https://developer.yahoo.com/apps/ (Fantasy read scope).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_LEAGUE_ID=nfl.l.000000
# YAHOO_TEAM_KEY=            # optional; auto-detected and cached otherwise

# --- ESPN fantasy ---
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_S2=                    # private league only (browser cookie)
ESPN_SWID=

# --- Odds ---
ODDS_PROVIDER=espn         # espn (no key) | sportsgameodds | theoddsapi
ODDS_API_KEY=

# --- ntfy push ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                 # pick something unguessable; subscribe on your phone
NTFY_PRIORITY=default
# NTFY_TOKEN=               # only if your topic is access-protected

# --- misc ---
TZ_NAME=America/New_York
DASHBOARD_URL=https://squid004.github.io/nfl-hub/
REMINDER_OFFSETS=24,3,0.75
QUIET_START=23
QUIET_END=7
